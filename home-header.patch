new file mode 100644
index 0000000..79978ed
--- /dev/null
+++ b/lib/features/home_screen/presentation/utils/user_title.dart
@@ -0,0 +1,13 @@
+import '../../../../core/l10n/app_localizations.dart';
+import '../../../questionnaire/domain/entities/verification_info_params.dart';
+import '../../../user_role_selection/presentation/widgets/role_selection_section.dart';
+
+extension UserTitleL10n on UserRole {
+  /// Courtesy title shown before the user's name: Dr. for a dentist,
+  /// Mr. / Mrs. for a patient (by [gender]). Empty when there is no role.
+  String title(AppLocalizations l10n, Gender gender) => switch (this) {
+    UserRole.dentist => l10n.titleDoctor,
+    UserRole.patient => gender == Gender.male ? l10n.titleMr : l10n.titleMrs,
+    UserRole.none => '',
+  };
+}
