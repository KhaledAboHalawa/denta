+++ b/lib/features/pending_matches/presentation/cubit/pending_matches_event.dart
@@ -0,0 +1,18 @@
+part of 'pending_matches_cubit.dart';
+
+sealed class PendingMatchesEvent extends Equatable {
+  const PendingMatchesEvent();
+
+  @override
+  List<Object?> get props => [];
+
+  T when<T>({required T Function() load}) {
+    return switch (this) {
+      PendingMatchesLoadEvent() => load(),
+    };
+  }
+}
+
+class PendingMatchesLoadEvent extends PendingMatchesEvent {
+  const PendingMatchesLoadEvent();
+}
diff --git a/lib/features/pending_matches/presentation/cubit/pending_matches_state.dart b/lib/features/pending_matches/presentation/cubit/pending_matches_state.dart
new file mode 100644
index 0000000..1154567
--- /dev/null
+++ b/lib/features/pending_matches/presentation/cubit/pending_matches_state.dart
@@ -0,0 +1,17 @@
+part of 'pending_matches_cubit.dart';
+
+class PendingMatchesState extends Equatable {
+  const PendingMatchesState({required this.matches});
+
+  const PendingMatchesState.initial()
+    : this(matches: const BaseState.initial());
+
+  final BaseState<List<PendingMatchEntity>> matches;
+
+  PendingMatchesState copyWith({
+    BaseState<List<PendingMatchEntity>>? matches,
+  }) => PendingMatchesState(matches: matches ?? this.matches);
+
+  @override
+  List<Object?> get props => [matches];
+}
