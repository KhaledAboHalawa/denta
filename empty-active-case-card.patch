diff --git a/lib/features/home_screen/presentation/widgets/empty_active_case_card.dart b/lib/features/home_screen/presentation/widgets/empty_active_case_card.dart
new file mode 100644
index 0000000..553e43a
--- /dev/null
+++ b/lib/features/home_screen/presentation/widgets/empty_active_case_card.dart
@@ -0,0 +1,111 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_svg/flutter_svg.dart';
+
+import '../../../../core/l10n/app_localizations.dart';
+import '../../../../core/theme/app_colors.dart';
+import '../../../../core/theme/app_typography.dart';
+import '../../../../core/utils/app_icons.dart';
+import '../../../../core/widgets/custom_button.dart';
+
+/// Home card shown instead of [ActiveCaseCard] when the student has no active
+/// case yet. It invites them to request their first case.
+class EmptyActiveCaseCard extends StatelessWidget {
+  const EmptyActiveCaseCard({super.key, required this.onRequestCase});
+
+  final VoidCallback onRequestCase;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = context.appColors;
+    final l10n = AppLocalizations.of(context)!;
+
+    return Container(
+      padding: const EdgeInsetsDirectional.symmetric(
+        horizontal: 20,
+        vertical: 24,
+      ),
+      margin: const EdgeInsets.symmetric(horizontal: 10),
+      decoration: BoxDecoration(
+        gradient: colors.dentaGradient,
+        borderRadius: BorderRadius.circular(12),
+        boxShadow: [
+          BoxShadow(
+            color: colors.primary.withValues(alpha: 0.35),
+            offset: const Offset(0, 3),
+            blurRadius: 7,
+          ),
+        ],
+      ),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          const Center(child: _HeroIllustration()),
+          const SizedBox(height: 12),
+          Text(
+            l10n.firstCaseTitle,
+            style: context.text.heading2.copyWith(color: colors.white),
+            maxLines: 2,
+            overflow: TextOverflow.ellipsis,
+          ),
+          const SizedBox(height: 16),
+          Text(
+            l10n.firstCaseSubtitle,
+            style: context.text.captionDefault.copyWith(color: colors.white),
+          ),
+          const SizedBox(height: 20),
+          CustomButton(
+            isLoading: false,
+            title: l10n.requestFirstCase,
+            onPressed: onRequestCase,
+            backgroundColor: colors.white,
+            foregroundColor: colors.primary,
+            height: 56,
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+/// Tooth ⇢ dashed arrow ⇢ pin. The arrow is mirrored in RTL so it keeps
+/// pointing from the tooth to the pin.
+class _HeroIllustration extends StatelessWidget {
+  const _HeroIllustration();
+
+  static const double _iconSize = 63.639;
+
+  @override
+  Widget build(BuildContext context) {
+    final isRtl = Directionality.of(context) == TextDirection.rtl;
+
+    Widget arrow = SvgPicture.asset(
+      AppIcons.emptyCaseWaveArrow,
+      height: 28.284,
+      fit: BoxFit.fill,
+    );
+    if (isRtl) arrow = Transform.flip(flipX: true, child: arrow);
+
+    return ConstrainedBox(
+      constraints: const BoxConstraints(maxWidth: 274),
+      child: Padding(
+        padding: const EdgeInsetsDirectional.symmetric(horizontal: 21.213),
+        child: Row(
+          children: [
+            SvgPicture.asset(
+              AppIcons.emptyCaseTooth,
+              width: _iconSize,
+              height: _iconSize,
+            ),
+            Expanded(child: arrow),
+            SvgPicture.asset(
+              AppIcons.emptyCasePin,
+              width: _iconSize,
+              height: _iconSize,
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
